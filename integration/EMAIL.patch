+/* ---------------- EContact ----------------
+ * EContact (github.com/whomper/EContact) keeps the contacts: its people
+ * are in the address book (^B), it opens its window when asked, and it
+ * hands over an address to write to with the AV protocol's VA_START
+ * ("mailto:name@example.com"). */
+
+#define VA_START 0x4711
+#define EC_OPEN  0x4543		/* 'EC': EContact, open your window */
+
+static short bootdev;
+static void sup_bootdev(void)
+{
+	__asm__ volatile("move.w 0x446.w,%0" : "=d"(bootdev));	/* _bootdev */
+}
+
+static void open_contacts(void)
+{
+	short id = appl_find("ECONTACT"), msg[8];
+	if (id < 0)
+		id = appl_find("ECONTST ");
+	if (id < 0) {
+		alert(1, "[1][EContact isn't loaded: put ECONTACT.ACC|in the root of the boot drive|and restart, or start ECONTACT.PRG.][ OK ]");
+		return;
+	}
+	memset(msg, 0, sizeof(msg));
+	msg[0] = EC_OPEN;
+	msg[1] = ap_id;
+	appl_write(id, 16, msg);
+}
+
+/* "mailto:a@b?subject=..." from EContact: a new message to a@b */
+static void got_va_start(short *msg)
+{
+	const char *s = (const char *)(((unsigned long)(unsigned short)msg[3] << 16) | (unsigned short)msg[4]);
+	char to[512];
+	ACCOUNT *a;
+	int n;
+	if (!s || strncasecmp(s, "mailto:", 7))
+		return;
+	str_copy(to, s + 7, sizeof(to));
+	n = (int)strcspn(to, "?");
+	to[n] = 0;
+	a = account_for_new();
+	if (a)
+		editor_open(a, compose_new(a, to), 0, 0);
+}
+
 static void command(short cmd)
 {
 	switch (cmd) {
 	case C_ABOUT: dlg_about(); break;
+	case C_CONTACTS: open_contacts(); break;
 	case C_NEW: {
 		ACCOUNT *a = account_for_new();
 		if (a)
@@ -967,6 +1017,8 @@ int main(void)
 		mem_unaligned_ok = get_cookie(0x5F435055L) >= 20;	/* _CPU */
 	}
 	ap_id = appl_init();
+	Supexec(sup_bootdev);
+	people_drive((char)('A' + bootdev));
 	if (ap_id < 0)
 		return 1;
 	vdi_h = graf_handle(&gl_wchar, &gl_hchar, &d, &d);
@@ -1045,6 +1097,9 @@ int main(void)
 			case AP_TERM:
 				quit = 1;
 				break;
+			case VA_START:
+				got_va_start(msg);
+				break;
 			default:
 				win_message(msg);
 			}
