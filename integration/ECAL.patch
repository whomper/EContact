+/* ---- invitations ----
+ * The people invited are picked from EContact's contacts (src/people.c,
+ * github.com/whomper/EContact) or typed as "Name <a@b>, c@d". The text
+ * shown leaves out this user (the organizer). */
+
+static void add_shown(const char *name, const char *email, void *ud)
+{
+	SBUF *b = ud;
+	if (ics_me[0] && !strcasecmp(email, ics_me))
+		return;
+	if (b->len)
+		sb_adds(b, ", ");
+	if (*name)
+		sb_printf(b, "%s <%s>", name, email);
+	else
+		sb_adds(b, email);
+}
+
+static void invitees_text(const EVENT *e, char *out, int size)
+{
+	SBUF b;
+	out[0] = 0;
+	if (!e->attendees)
+		return;
+	sb_init(&b);
+	ics_each_address(e->attendees, add_shown, &b);
+	if (b.len)
+		str_copy(out, b.s, size);
+	sb_free(&b);
+}
+
+/* Add...: someone from Contacts, or a whole group; a name begun in the
+   field ("Bob, ma") is completed */
+static void add_invitee(char *line, int size)
+{
+	char part[100], *full;
+	PPICK *l;
+	int n, k;
+	people_partial(line, part, sizeof(part));
+	n = people_pick_list(part, &l);
+	if (!n) {
+		if (!people_available())
+			alert(1, "[1][Invitations come from EContact,|the contacts program: install it|and add your contacts there.|Or type addresses here.][ OK ]");
+		else
+			alert(1, "[1][Nobody in Contacts matches|\"%s\".][ OK ]", part);
+		return;
+	}
+	if (n == 1 && part[0]) {
+		k = 0;
+	} else {
+		const char **items = malloc(n * sizeof(char *));
+		int i;
+		if (!items) {
+			people_pick_free(l, n);
+			return;
+		}
+		for (i = 0; i < n; i++)
+			items[i] = l[i].label;
+		k = dlg_pick("Invite from Contacts", items, (short)n, 0);
+		free(items);
+	}
+	if (k >= 0 && (full = people_complete(line, l[k].value)) != 0) {
+		if ((int)strlen(full) < size)
+			strcpy(line, full);
+		else
+			alert(1, "[1][That's too many invitees for|one event.][ OK ]");
+		free(full);
+	}
+	people_pick_free(l, n);
+}
